rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for ID verification
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /residents/{residentId} {
      allow read: if true;
      allow write: if isValidId(residentId);
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if isValidId(paymentId);
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId);
    }
  }
}
